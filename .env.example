# ──────────────────────────────────────────────────────────────
# Dr. ARIA — environment variables
# Copy this file to `.env` and fill in your own keys.
# .env is listed in .gitignore and MUST NEVER be committed.
# ──────────────────────────────────────────────────────────────

# Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Groq model (default is fine — override only if you need a different model)
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace token — create one at https://huggingface.co/settings/tokens
# Only "read" scope is required. Used to download IU X-Ray and medical-QA datasets.
# Leave blank if you only want the curated RAG corpus.
HF_TOKEN=your_hf_token_here